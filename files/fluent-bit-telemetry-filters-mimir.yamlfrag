    # Turn numeric telemetry records into real metrics so they can be pushed over OTLP.
    - name: log_to_metrics
      match: movai.telemetry.metrics
      tag: movai.telemetry.metrics.generated
      metric_mode: gauge
      metric_name: movai_metric_value
      metric_description: MOVAI numeric telemetry value
      value_field: value
      # Emit one snapshot of all series per interval; without it every record re-emits
      # the full snapshot and floods the emitter, back-pressuring the forward socket.
      flush_interval_sec: 10
      flush_interval_nsec: 0
      emitter_mem_buf_limit: 20M
      label_field:
        - metric_name
        - metric_group
        - fleet
        - robot
        - service
        - flow
        - node
        - pattern
        - active
        - alert_id
        - event_type
