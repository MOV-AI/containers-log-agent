    # Split the single telemetry stream by telemetry_type so each kind gets its own backend.
    - name: rewrite_tag
      match: movai.telemetry.raw
      rule:
        - "$telemetry_type ^metric$ movai.telemetry.metrics false"
        - "$telemetry_type ^event$ movai.telemetry.events false"
        - "$telemetry_type ^notification$ movai.telemetry.notifications false"
        - "$telemetry_type ^alert$ movai.telemetry.alerts false"
