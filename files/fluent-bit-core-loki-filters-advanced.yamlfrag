    # STAGE 1: Identify MOV.AI services for structured log parsing
    # Re-tag backend/spawner/orchestrator/ros1-workspace/ros2-workspace logs to 'movai.logs' for MOV.AI-specific parsing pipeline
    # Other services keep 'docker.*' tag and go through generic parsing only
    - name: rewrite_tag
      match: docker.*
      rule:
        - "$service ^(backend|spawner|orchestrator|ros1-workspace|ros2-workspace)$ movai.logs false"
      emitter_name: re_emitted

    # STAGE 2: MOV.AI Structured Log Processing (movai.logs only)
    # Pre-processing: Strip ANSI color codes and enrich callback fields.
    # Tag extraction supports both pre-parsed 'tags' and raw callback 'log' format,
    # so this Lua stage can run before parser filters without losing ui/node fields.
    - name: lua
      match: movai.logs
      script: /fluent-bit/etc/parse_callback_tags.lua
      call: parse_callback_tags

    # Parse MOV.AI callback format with dynamic tags (ui, node, etc.)
    - name: parser
      match: movai.logs
      key_name: log
      parser: callback_logs
      preserve_key: true
      reserve_data: true

    # Parse MOV.AI Python structured logs
    - name: parser
      match: movai.logs
      key_name: log
      parser: python_structured
      preserve_key: true
      reserve_data: true

    # Normalize Python log level field for Loki labeling
    - name: modify
      match: movai.logs
      rename:
        - levelname level

    # STAGE 3: Generic parsers (fallback) for all logs
    # Applied to other services
    - name: parser
      match: docker.*
      key_name: log
      parser: app_logs
      preserve_key: true
      reserve_data: true

    - name: parser
      match: docker.*
      key_name: log
      parser: docker
      preserve_key: true
      reserve_data: true
